{
  "version": 1,
  "description": "Intentional npm runtime contents; native crates and repository state ship separately.",
  "allowed_root_files": [
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "package.json",
    "server.json",
    "bun.lock",
    "setup.sh",
    "demo-no-key.sh",
    "package-contents.json",
    "docs/RECOVERY.md",
    "docs/CANONICAL-FORMATS.md",
    "docs/LOCAL-WORKFLOW-APIS.md",
    "docs/PROTECTED-WRITE.md",
    "docs/LINUX-SERVICE.md",
    "docs/NATIVE-MEMORY.md",
    "docs/GITHUB-ACTION.md",
    "docs/ROUTING.md",
    "docs/EVALUATOR.md"
  ],
  "allowed_prefixes": [
    "bin/",
    "src/security/",
    "src/scheduler/",
    "src/swarm/",
    "src/growth/",
    "skills/",
    "hooks/",
    "hosts/",
    "src/routing/"
  ],
  "required_files": [
    "bin/kineti.js",
    "bin/lib.ts",
    "bin/ledger-integrity.ts",
    "bin/kineti-mcp.ts",
    "bin/kineti-evidence.ts",
