    "skills/design/SKILL.md",
    "setup.sh"
  ],
  "forbidden_files": [
    "install.sh",
    "kineti.config.json",
    "bin/kineti-ingestion.ts",
    "hosts/ingestion-proposal.v1.json",
    "Cargo.toml",
    "Cargo.lock"
  ]
}
