[Unit]
Description=Kineti trusted fake-publish evaluator
After=local-fs.target

[Service]
User=evaluator
Group=evaluator
ExecStart=/usr/local/bin/kineti-cli evaluator serve /var/lib/kineti/state /run/kineti/evaluator.sock
RuntimeDirectory=kineti
RuntimeDirectoryMode=0755
PrivateNetwork=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/kineti /var/lib/kineti-jobs /run/kineti
MemoryMax=256M
TasksMax=64
UMask=0077
Restart=no

[Install]
WantedBy=multi-user.target
