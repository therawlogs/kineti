#!/bin/sh
set -eu
[ "$#" -eq 3 ] || exit 2
case "$1" in /var/lib/kineti-jobs/????????-????-????-????-????????????.sh) ;; *) exit 2 ;; esac
[ -f "$1" ] && [ ! -L "$1" ] || exit 2
for n in "$2" "$3"; do
  case "$n" in -*) n=${n#-} ;; esac
  case "$n" in ''|*[!0-9]*) exit 2 ;; esac
done
ulimit -t 2
ulimit -f 32
ulimit -v 65536
status=0
/usr/bin/setpriv --reuid=10002 --regid=10002 --clear-groups --no-new-privs /usr/bin/timeout --signal=KILL 3 /bin/sh "$1" "$2" "$3" || status=$?
# The worker UID is exclusive to this serial evaluator. Also kill detached descendants.
/usr/bin/setpriv --reuid=10002 --regid=10002 --clear-groups --no-new-privs /bin/kill -KILL -1 >/dev/null 2>&1 || true
exit "$status"
