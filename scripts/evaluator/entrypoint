#!/bin/sh
set -eu
chmod 0711 /var/lib/kineti-jobs
mkdir -p /run/kineti
chmod 0755 /run/kineti
chown evaluator:evaluator /var/lib/kineti /var/lib/kineti-jobs /run/kineti
if [ ! -d /var/lib/kineti/state ]; then
  runuser -u evaluator -- /usr/local/bin/kineti-cli evaluator init /var/lib/kineti/state
fi
rm -f /run/kineti/evaluator.sock
exec runuser -u evaluator -- /usr/local/bin/kineti-cli evaluator serve /var/lib/kineti/state /run/kineti/evaluator.sock
