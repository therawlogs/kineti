{
  "name": "kineti",
  "version": "0.6.0",
  "description": "Native checks, changed-input detection, reported-spending CI gate and registered undo",
  "license": "MIT",
  "mcpName": "io.github.therawlogs/kineti",
  "repository": { "type": "git", "url": "https://github.com/therawlogs/kineti.git" },
  "homepage": "https://github.com/therawlogs/kineti",
  "bin": { "kineti": "bin/kineti" },
  "engines": { "node": ">=18" },
  "os": ["linux", "darwin"],
  "cpu": ["x64", "arm64"],
  "files": ["bin/kineti", "install.cjs", "checksums.json", "native/", "README.md", "LICENSE"],
  "scripts": {
    "postinstall": "node install.cjs",
    "prepublishOnly": "node scripts/check-native-package.cjs",
    "test": "cargo test --manifest-path core-native/Cargo.toml -p kineti-cli"
  },
  "keywords": ["gate", "test-receipts", "reported-spending", "undo", "mcp", "native"]
}
