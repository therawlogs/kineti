{
  "name": "kineti",
  "version": "1.0.0",
  "description": "Open-core AI-PR verification & anti-tampering gate: base-branch policy lock, polyglot test-tamper scanner, signed audit bundles, and reported-spending CI gate",
  "license": "MIT",
  "mcpName": "io.github.therawlogs/kineti",
  "repository": { "type": "git", "url": "https://github.com/therawlogs/kineti.git" },
  "homepage": "https://getkineti.com",
  "bin": { "kineti": "bin/kineti" },
  "engines": { "node": ">=18" },
  "os": ["linux", "darwin"],
  "cpu": ["x64", "arm64"],
  "files": ["bin/kineti", "install.cjs", "checksums.json", "native/", "README.md", "LICENSE"],
  "scripts": {
    "postinstall": "node install.cjs",
    "prepublishOnly": "node scripts/check-native-package.cjs",
    "test": "cargo test --manifest-path core-native/Cargo.toml -p kineti-cli"
  },
  "keywords": ["ai-pr-gate", "pr-verification", "anti-tampering", "github-actions", "test-receipts", "mcp", "native"]
}
